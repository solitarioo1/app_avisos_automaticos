# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
# Cambiar estos valores por los de tu VPS
DB_HOST=postgres
DB_PORT=5432
DB_NAME=procesar_aviso
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura_aqui

# ========================================
# CONFIGURACIÓN DE APLICACIÓN
# ========================================
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# Precarga en background las capas de riesgo pesadas (Inundación/Mov. Masa,
# hasta 1.1GB) apenas arranca el servidor, para que el primer usuario real no
# pague esa carga. Default activada (no hace falta definirla en producción).
# Poner en 0 SOLO en desarrollo local, para reiniciar rápido mientras se prueba.
PRECARGAR_CAPAS=1

# Ruta al binario de Tesseract OCR -- opcional, normalmente se detecta solo
# (en Docker/Linux queda en el PATH del sistema; en Windows busca la ruta
# default de instalación). Solo hace falta si Tesseract está en otro lado.
TESSERACT_CMD=

# ========================================
# LOGIN (admin + inspector)
# ========================================
# Usuario y contraseña directos (mismo criterio que DB_PASSWORD de arriba --
# texto plano acá, nunca en el código/git). El código los hashea solo
# internamente para comparar en el login. Si falta alguno de los 2 pares,
# ese usuario no puede loguearse.
ADMIN_USERNAME=tu_usuario_admin
ADMIN_PASSWORD=tu_contraseña_admin_aqui
INSPECTOR_USERNAME=tu_usuario_inspector
INSPECTOR_PASSWORD=tu_contraseña_inspector_aqui

# ========================================
# SEGURIDAD
# ========================================
# Clave de sesión de Flask -- OBLIGATORIO poner una real en producción. Si
# falta, el código cae a un default que está escrito en el propio repo
# (público en GitHub) y cualquiera podría forjar una sesión con ella.
# Generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generar_una_clave_larga_random_aca

# Permite que n8n llame a la API saltándose el login, mandando el header
# "X-API-Key" con este mismo valor (ver app.py). Vacío = ese acceso directo
# queda desactivado -- dejarlo vacío salvo que algún flujo de n8n lo necesite.
API_KEY=

# true en producción (el sitio corre con HTTPS) -- evita que la cookie de
# sesión viaje por HTTP sin cifrar. Dejar vacío/false en desarrollo local.
COOKIE_SECURE=true

# Límite de tamaño por request (MB) -- frena uploads gigantes antes de que
# lleguen a procesarse. Default 25 si no se define.
MAX_UPLOAD_MB=25

# ========================================
# CONFIGURACIÓN DE DOMINIO
# ========================================
# DOMAIN se usa en app.py para armar URLs de mapas (ej. link a la imagen en
# mensajes a clientes) — si falta, cae a un default hardcodeado, mejor setearla.
APP_DOMAIN=https://tu-dominio.example.com
APP_URL=https://tu-dominio.example.com
DOMAIN=https://tu-dominio.example.com

# ========================================
# CONFIGURACIÓN DE RUTAS
# ========================================
TEMP_DIR=/app/TEMP
OUTPUT_DIR=/app/OUTPUT
LAYOUT_DIR=/app/LAYOUT
JSON_DIR=/app/JSON
SHP_BASE_DIR=/app/DELIMITACIONES

# ========================================
# WEBHOOKS N8N — Módulo de Difusión
# ========================================
# Webhook para que n8n genere los mensajes y los guarde en clientes_envios
N8N_WEBHOOK_GENERAR=https://tu-n8n.example.com/webhook/generar-mensajes

# Webhook para que n8n despache los mensajes por WhatsApp
N8N_WEBHOOK_ENVIAR_WA=https://tu-n8n.example.com/webhook/enviar-whatsapp

# Webhook para que n8n despache los mensajes por SMS
N8N_WEBHOOK_ENVIAR_SMS=https://tu-n8n.example.com/webhook/enviar-sms

# Webhook para que n8n despache los mensajes por Email
N8N_WEBHOOK_ENVIAR_EMAIL=https://tu-n8n.example.com/webhook/enviar-email

# ========================================
# WEBHOOKS N8N — Módulo de Mensajería (plantillas fijas + Google Sheets)
# ========================================
GOOGLE_CREDENTIALS_B64=
# Alternativa a GOOGLE_CREDENTIALS_B64 para desarrollo local: ruta directa al
# archivo credentials.json en vez del contenido en base64. Si se definen las
# dos, GOOGLE_CREDENTIALS_B64 tiene prioridad.
GOOGLE_CREDENTIALS_JSON=credentials.json
MENSAJERIA_SHEET_ID=
N8N_WEBHOOK_AFILIACIONES=https://tu-n8n.example.com/webhook/afiliaciones
N8N_WEBHOOK_RESULTADOS=https://tu-n8n.example.com/webhook/resultados
N8N_WEBHOOK_INDEMNIZACIONES=https://tu-n8n.example.com/webhook/indemnizaciones
N8N_WEBHOOK_ALERTAS=https://tu-n8n.example.com/webhook/alertas
# Pólizas: único tipo con adjunto PDF (busca el archivo en Drive por nombre_poliza)
N8N_WEBHOOK_POLIZAS=https://tu-n8n.example.com/webhook/polizas

# ========================================
# WEBHOOKS N8N — Siniestros (formulario público del agricultor)
# ========================================
# Recibe las fotos en base64 del formulario /siniestro/reportar, las sube a
# Drive y registra una fila en un Sheet.
N8N_WEBHOOK_SINIESTRO_FOTO=https://tu-n8n.example.com/webhook/siniestro-foto
# Manda el correo de confirmacion al agricultor cuando completa el formulario.
N8N_WEBHOOK_SINIESTRO_EMAIL=https://tu-n8n.example.com/webhook/siniestro-email

# OCR de respaldo con IA (Gemini) -- ULTIMO intento cuando EXIF y el OCR local
# (Tesseract) ya fallaron los dos, para fotos sin metadata y con watermark en
# un formato raro que el regex local no reconoce. Opcional: si no se define,
# el sistema simplemente no intenta este paso (igual que hoy).
N8N_WEBHOOK_OCR_IA=https://tu-n8n.example.com/webhook/ocr-foto-ia
