# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
# Cambiar estos valores por los de tu VPS
DB_HOST=postgres
DB_PORT=5432
DB_NAME=procesar_aviso
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura_aqui

# ========================================
# CONFIGURACIÓN DE APLICACIÓN
# ========================================
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# ========================================
# CONFIGURACIÓN DE DOMINIO
# ========================================
# DOMAIN se usa en app.py para armar URLs de mapas (ej. link a la imagen en
# mensajes a clientes) — si falta, cae a un default hardcodeado, mejor setearla.
APP_DOMAIN=https://tu-dominio.example.com
APP_URL=https://tu-dominio.example.com
DOMAIN=https://tu-dominio.example.com

# ========================================
# CONFIGURACIÓN DE RUTAS
# ========================================
TEMP_DIR=/app/TEMP
OUTPUT_DIR=/app/OUTPUT
LAYOUT_DIR=/app/LAYOUT
JSON_DIR=/app/JSON
SHP_BASE_DIR=/app/DELIMITACIONES

# ========================================
# WEBHOOKS N8N — Módulo de Difusión
# ========================================
# Webhook para que n8n genere los mensajes y los guarde en clientes_envios
N8N_WEBHOOK_GENERAR=https://tu-n8n.example.com/webhook/generar-mensajes

# Webhook para que n8n despache los mensajes por WhatsApp
N8N_WEBHOOK_ENVIAR_WA=https://tu-n8n.example.com/webhook/enviar-whatsapp

# Webhook para que n8n despache los mensajes por SMS
N8N_WEBHOOK_ENVIAR_SMS=https://tu-n8n.example.com/webhook/enviar-sms

# Webhook para que n8n despache los mensajes por Email
N8N_WEBHOOK_ENVIAR_EMAIL=https://tu-n8n.example.com/webhook/enviar-email

# ========================================
# WEBHOOKS N8N — Módulo de Mensajería (plantillas fijas + Google Sheets)
# ========================================
GOOGLE_CREDENTIALS_B64=
MENSAJERIA_SHEET_ID=
N8N_WEBHOOK_AFILIACIONES=https://tu-n8n.example.com/webhook/afiliaciones
N8N_WEBHOOK_RESULTADOS=https://tu-n8n.example.com/webhook/resultados
N8N_WEBHOOK_INDEMNIZACIONES=https://tu-n8n.example.com/webhook/indemnizaciones
N8N_WEBHOOK_ALERTAS=https://tu-n8n.example.com/webhook/alertas
# Pólizas: único tipo con adjunto PDF (busca el archivo en Drive por nombre_poliza)
N8N_WEBHOOK_POLIZAS=https://tu-n8n.example.com/webhook/polizas
