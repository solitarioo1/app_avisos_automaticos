# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
# Cambiar estos valores por los de tu VPS
DB_HOST=postgres
DB_PORT=5432
DB_NAME=procesar_aviso
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura_aqui

# ========================================
# CONFIGURACIÓN DE APLICACIÓN
# ========================================
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# ========================================
# CONFIGURACIÓN DE RUTAS
# ========================================
TEMP_DIR=/app/TEMP
OUTPUT_DIR=/app/OUTPUT
LAYOUT_DIR=/app/LAYOUT
JSON_DIR=/app/JSON
SHP_BASE_DIR=/app/DELIMITACIONES

# ========================================
# WEBHOOKS N8N — Módulo de Difusión
# ========================================
# Webhook para que n8n genere los mensajes y los guarde en clientes_envios
N8N_WEBHOOK_GENERAR=https://tu-n8n.example.com/webhook/generar-mensajes

# Webhook para que n8n despache los mensajes por WhatsApp
N8N_WEBHOOK_ENVIAR_WA=https://tu-n8n.example.com/webhook/enviar-whatsapp

# Webhook para que n8n despache los mensajes por SMS
N8N_WEBHOOK_ENVIAR_SMS=https://tu-n8n.example.com/webhook/enviar-sms

# Webhook para que n8n despache los mensajes por Email
N8N_WEBHOOK_ENVIAR_EMAIL=https://tu-n8n.example.com/webhook/enviar-email
